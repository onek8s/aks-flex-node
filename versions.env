# Every input of the image, pinned with its digest. scripts read this file with `source`; change a
# version together with its digest (the release's checksums.txt, or `sha256sum` of the file).

# Ubuntu 24.04 LTS server cloud image (the generic kernel: virtio and Hyper-V drivers). A serial
# under https://cloud-images.ubuntu.com/noble/ stays published, unlike `current`.
UBUNTU_SERIAL=20261017
UBUNTU_IMAGE_URL=https://cloud-images.ubuntu.com/noble/${UBUNTU_SERIAL}/noble-server-cloudimg-amd64.img
UBUNTU_IMAGE_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94

# AKS Flex Node agent (https://github.com/Azure/AKSFlexNode). The release publishes no digest for
# bootstrap.sh, so its digest is ours: that of the file at the release's tag.
AKS_FLEX_NODE_VERSION=v0.2.0
AKS_FLEX_NODE_ARCHIVE_SHA256=b29a9f8f2d3ba11aa616f9fc6c0dd16d0ef5639b3ef35851671b3869b3855a2d
AKS_FLEX_NODE_BOOTSTRAP_SHA256=c625a2ba77748efac464269428d19c90ddbf7ecb96619411398b5cf0ca20dedf

# Azure Connected Machine agent (Azure Arc), installed but not connected: packages.microsoft.com,
# Ubuntu 24.04 prod.
AZCMAGENT_VERSION=1.63.03384.1014

# The OS disk's virtual size; the agent wants 8 GiB free under /var/lib, Microsoft's examples 32 GiB.
DISK_SIZE=32G
